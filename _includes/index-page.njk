<!-- INTRO -->
<div class="intro">
  Over the last few years, the London based imprint, Hegoa, has taken great strides toward illuminating the shadowy world of contemporary music emerging from the Basque region, an autonomous community in northern Spain with its own distinct cultural traditions and language.
</div>

<!-- CONTACT + GALLERY (placed below intro, above watch) -->
<div class="column">

  <div class="entry-block">
    <div class="section-title">contact</div>
    <div class="entries">
      <a href="mailto:hegoadiskak.eu@gmail.com">mail</a>
    </div>
  </div>

  <div class="entry-block">
    <div class="section-title">gallery</div>
    <div class="entries">
      <a href="https://www.instagram.com/hegoadiskak/?hl=en" target="_blank" rel="noopener">
        instagram
      </a>
    </div>
  </div>

</div>

<!-- WATCH -->
<div class="entry-block">
  <div class="section-title">watch</div>
  <div class="entries">
    {% for item in collections.watch %}
      <a href="{{ item.url }}">{{ item.data.title }}</a>
    {% endfor %}
  </div>
</div>

<!-- MAIN COLUMN -->
<div class="column">

  <div class="entry-block">
    <div class="section-title">catalog</div>
    <div class="entries">
      {% for item in collections.releases %}
        <a href="{{ item.url }}">{{ item.data.title }}</a>
      {% endfor %}
    </div>
  </div>

  <div class="entry-block">
    <div class="section-title">radio</div>
    <div class="entries">
      {% for item in collections.radio %}
        <a href="{{ item.data.external_url }}" target="_blank" rel="noopener">
          {{ item.data.title }}
        </a>
      {% endfor %}
    </div>
  </div>

  <div class="entry-block">
    <div class="section-title">live</div>
    <div class="entries">
      {% for item in collections.live %}
        <a href="{{ item.url }}">{{ item.data.title }}</a>
      {% endfor %}
    </div>
  </div>

  <div class="entry-block">
    <div class="section-title">read</div>
    <div class="entries">
      {% for item in collections.read %}
        <a href="{{ item.data.external_url }}" target="_blank" rel="noopener">
          {{ item.data.title }}
        </a>
      {% endfor %}
    </div>
  </div>

</div>
